<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>DigitWindowsBLE</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><None Include="..\build\digit_queue.dll" Link="digit_queue.dll" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="RequireNativeCore" BeforeTargets="Build">
    <Error Condition="!Exists('..\build\digit_queue.dll')" Text="Run scripts\build-native.cmd from an x64 VS Developer Command Prompt first." />
  </Target>
</Project>
